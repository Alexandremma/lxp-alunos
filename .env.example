# =============================================================================
# lxp-alunos — variáveis de ambiente (Vite)
# Copie para .env e preencha os valores. Nunca commitar .env com segredos reais.
# Lista operacional: docs/entrega/03-secrets-e-edges.md
# =============================================================================

# --- Supabase (obrigatório) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Alice / EaDStock — catálogo de aulas e player iframe (obrigatório em homolog/prod) ---
# Par de chaves com prefixo "alunos-" (fornecido pela B42).
VITE_ALICE_BASE_URL=https://alice.eadstock.com.br
VITE_ALICE_API_KEY=
VITE_ALICE_API_SECRET=

# Opcional: launch do player Alice via http:// (apenas dev/piloto)
# VITE_ALICE_LAUNCH_USE_HTTP=true

# --- Auth — redirect após e-mail de redefinição / convite ---
# Homolog: https://lxp-alunos.vercel.app/definir-senha
VITE_LXP_ALUNOS_SET_PASSWORD_URL=

# --- Certificados — URL pública do portal aluno (QR + validação) ---
# Homolog: https://lxp-alunos.vercel.app
# Produção: definir o domínio final do app alunos
VITE_LXP_ALUNOS_PUBLIC_ORIGIN=
